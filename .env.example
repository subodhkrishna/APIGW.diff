# API Gateway Comparison Testing Framework
# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Kong Gateway
KONG_PROXY_URL=https://kong.example.com
KONG_ADMIN_URL=https://kong-admin.example.com
KONG_API_KEY=your-kong-api-key

# AWS API Gateway
AWS_API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod
AWS_REGION=us-east-1
AWS_API_ID=your-api-id
AWS_STAGE=prod
AWS_API_KEY=your-aws-api-key

# Or use AWS credentials
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# NGINX
NGINX_URL=https://nginx.example.com
NGINX_API_URL=https://nginx-api.example.com

# Traefik
TRAEFIK_URL=https://traefik.example.com
TRAEFIK_API_URL=https://traefik-api.example.com

# Envoy
ENVOY_URL=https://envoy.example.com
ENVOY_ADMIN_URL=https://envoy-admin.example.com

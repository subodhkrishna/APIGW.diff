# Example Credentials Configuration
# Copy this file to credentials.yaml and fill in your credentials
# DO NOT commit credentials.yaml to version control!

credentials:
  kong:
    api_key: "your-kong-api-key"

  aws_api_gateway:
    api_key: "your-aws-api-key"
    # Or use AWS credential chain
    access_key_id: "your-access-key-id"
    secret_access_key: "your-secret-access-key"

  # Add other gateway credentials as needed
